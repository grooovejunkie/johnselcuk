{
  "manifest_version": 3,
  "name": "SDM — İndirme Yakalayıcı",
  "version": "1.0.2",
  "description": "Chrome indirmelerini ve sayfalardaki videoları SDM İndirme Yöneticisi'ne gönderir.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SDM"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "cookies",
    "webRequest",
    "storage",
    "contextMenus",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "minimum_chrome_version": "116"
}
